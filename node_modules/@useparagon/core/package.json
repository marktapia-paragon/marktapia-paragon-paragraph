{
  "name": "@useparagon/core",
  "version": "1.1.11",
  "description": "Core libraries for paragraph",
  "repository": "https://github.com/useparagon/paragraph",
  "packageManager": "pnpm@8.10.5",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "./dist/index.js",
  "types": "./dist/index.d.js",
  "files": [
    "./dist/",
    "!./dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./src/*/index.ts",
      "require": "./dist/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*/index.d.js",
        "./dist/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "cron-parser": "4.9.0",
    "stacktrace-parser": "0.1.10",
    "tslib": "2.3.1",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "3.1022.0",
    "@aws-sdk/lib-dynamodb": "3.1022.0",
    "@aws-sdk/lib-storage": "3.1022.0",
    "@azure/storage-blob": "12.31.0",
    "@sendgrid/mail": "7.7.0",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/analytics-node": "3.1.14",
    "@types/archiver": "5.3.4",
    "@types/bluebird": "3.5.42",
    "@types/cloudflare": "2.7.13",
    "@types/html-pdf": "3.0.3",
    "@types/jsforce": "1.11.5",
    "@types/jsonwebtoken": "9.0.5",
    "@types/lodash": "4.14.202",
    "@types/luxon": "3.3.7",
    "@types/mssql": "9.1.4",
    "@types/node": "18.19.3",
    "@types/node-fetch": "2.6.10",
    "@types/number-to-words": "1.2.3",
    "@types/oauth": "0.9.4",
    "@types/pg": "8.10.9",
    "@types/postlight__mercury-parser": "2.2.7",
    "@types/ramda": "0.29.9",
    "@types/snowflake-sdk": "1.6.20",
    "@types/ssh2-sftp-client": "5.3.2",
    "@types/underscore": "1.11.15",
    "@types/underscore.string": "0.0.41",
    "@types/unzipper": "0.10.9",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "aws-sdk": "2.1528.0",
    "cheerio": "1.0.0-rc.12",
    "csv": "5.5.3",
    "date-fns": "2.30.0",
    "eslint": "8.55.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jest": "27.6.0",
    "fast-xml-parser": "3.21.1",
    "firebase": "9.23.0",
    "form-data": "4.0.5",
    "ioredis": "5.10.1",
    "libphonenumber-js": "1.12.41",
    "mailgun.js": "12.7.1",
    "moment": "2.30.1",
    "mysql2": "3.16.3",
    "neo4j-driver": "5.16.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.1.1",
    "prettier-plugin-organize-imports": "3.2.4",
    "promise-parallel-throttle": "3.3.0",
    "redis": "4.6.12",
    "rimraf": "4.4.1",
    "sendpulse-api": "1.1.6",
    "slack": "11.0.2",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "twilio": "3.84.1",
    "typescript": "5.3.3",
    "unzipper": "0.10.14",
    "url": "0.11.3"
  },
  "scripts": {
    "build": "tsc -b tsconfig.release.json",
    "build:watch": "tsc -b tsconfig.release.json -w",
    "build:dev": "tsc -b tsconfig.json",
    "build:dev:watch": "tsc -b tsconfig.json -w",
    "clean": "rimraf ./dist ./coverage",
    "format": "prettier --ignore-path ../../.prettierignore --config ../../.prettierrc --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --config ../../.prettierrc --check .",
    "lint": "eslint --ignore-path ../../.eslintignore --config ../../.eslintrc.json --ext .ts .",
    "lint:fix": "eslint --ignore-path ../../.eslintignore --config ../../.eslintrc.json --ext .ts --fix .",
    "release:publish:canary": "pnpm publish --tag next",
    "release:publish:stable": "pnpm publish --tag latest",
    "start:dev": "ts-node -r tsconfig-paths/register src/index.ts"
  }
}